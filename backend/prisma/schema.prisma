generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ExchangeAccount {
  id           String      @id @default(uuid())
  name         String
  exchange     String      @default("binance")
  marketType   String      @default("spot")
  apiKeyEnc    String
  apiSecretEnc String
  testnet      Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  bots         SignalBot[]
  manualOrders ManualOrder[]
  spotExecutionOrders SpotExecutionOrder[]
  derivativeExecutionOrders DerivativeExecutionOrder[]
  smartTrades  SmartTrade[]
}

/**
 * X3A venue-neutral crypto Spot execution ledger.
 *
 * The Platform identity and complete monetary request are durable before the
 * status may become `submitted`. Once submitted, recovery is query-only: an
 * unknown acknowledgement can never create a second provider order.
 */
model SpotExecutionOrder {
  id                    String          @id @default(uuid())
  platformIntentId      String          @unique
  platformDedupeKey     String          @unique
  platformPayloadHash   String
  platformIntentCreatedAt DateTime
  exchangeAccountId     String
  exchangeAccount       ExchangeAccount @relation(fields: [exchangeAccountId], references: [id])
  venue                 String
  environment           String
  canonicalInstrumentId String
  venueSymbol           String
  side                  String
  orderType             String
  timeInForce           String?
  requestedBaseQty      String?
  requestedQuoteQty     String?
  limitPrice            String?
  paperReferencePrice   String?
  clientOrderId         String          @unique
  status                String          @default("requested")
  providerOrderId       String?
  providerStatus        String?
  filledBaseQty         String          @default("0")
  filledQuoteQty        String          @default("0")
  averageFillPrice      String?
  feeAmount             String?
  feeAsset              String?
  error                 String?
  submittedAt           DateTime?
  acknowledgedAt        DateTime?
  lastFillAt            DateTime?
  reconciledAt          DateTime?
  completedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([exchangeAccountId, venueSymbol, createdAt])
}

/**
 * X3B venue-neutral crypto derivatives execution ledger.
 *
 * The complete exposure-changing request and the Platform identity are
 * durable before submission. An ambiguous acknowledgement is reconciled by
 * client order id and is never resubmitted.
 */
model DerivativeExecutionOrder {
  id                      String          @id @default(uuid())
  platformIntentId        String          @unique
  platformDedupeKey       String          @unique
  platformPayloadHash     String
  platformIntentCreatedAt DateTime
  exchangeAccountId       String
  exchangeAccount         ExchangeAccount @relation(fields: [exchangeAccountId], references: [id])
  venue                   String
  environment             String
  canonicalInstrumentId   String
  venueSymbol             String
  contractKind            String
  contractSize            String
  baseCurrency            String
  quoteCurrency           String
  settlementCurrency      String
  marginCurrency          String
  expiry                   DateTime?
  positionDirection       String
  actionSide               String
  quantityUnit            String
  requestedQuantity       String?
  marginMode              String
  leverage                String?
  positionMode            String
  reduceOnly              Boolean         @default(false)
  closePosition           Boolean         @default(false)
  orderType               String
  timeInForce             String?
  limitPrice              String?
  triggerPrice            String?
  triggerPriceRole        String?
  protectionKind          String?
  paperReferencePrice     String?
  positionSnapshot        String?
  shariahContext          String?
  clientOrderId           String          @unique
  status                  String          @default("requested")
  providerOrderId         String?
  providerStatus          String?
  filledContracts         String          @default("0")
  filledBaseQty           String          @default("0")
  filledNotional          String          @default("0")
  averageFillPrice        String?
  realizedPnl             String          @default("0")
  unrealizedPnl           String          @default("0")
  pnlCurrency             String?
  fundingAmount           String          @default("0")
  fundingCurrency         String?
  feeAmount               String?
  feeCurrency             String?
  markPrice               String?
  indexPrice              String?
  lastPrice               String?
  liquidationPrice        String?
  maintenanceMargin       String?
  error                   String?
  submittedAt             DateTime?
  acknowledgedAt          DateTime?
  lastFillAt              DateTime?
  reconciledAt            DateTime?
  completedAt             DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([exchangeAccountId, venueSymbol, createdAt])
}

model SignalBot {
  id                String @id @default(uuid())
  name              String
  alertType         String @default("custom")
  // BOT-012: only "long" is implemented. `binance.ts` hardcodes BUY/SELL and
  // the value's only backend consumer is a cosmetic label, so "short" and
  // "reversal" were accepted, stored, offered in the UI, and silently ignored.
  // The API now refuses anything else; the column keeps existing rows readable.
  direction         String @default("long")
  pairs             String
  /**
   * BOT-003: this defaulted to 100 with entryVolumePct 100, which makes
   * `configuredMaximum === usdtBalance` — one order for the entire free USDT
   * balance. Combined with stopLossEnabled false, takeProfitEnabled false and
   * exitEnabled false, a bot created by filling in only a name and a pair
   * converted the whole balance into one spot position with NO automated exit
   * path at all.
   * The default is now 5 %. Existing rows keep their stored values — this
   * changes what a NEW bot starts as, not what a running one does.
   */
  maxInvestmentPct  Float  @default(5)
  maxInvestmentUnit String @default("pct_bot")
  status            String @default("active")
  webhookSecret     String @unique

  entryEnabled                Boolean @default(true)
  entryVolumePct              Float   @default(100)
  entryOrderType              String  @default("market")
  // BOT-015: this defaulted to false, so a default bot REJECTED every exit
  // webhook — `webhook.ts` enforces it — while BOT_COMPLETE_GUIDE.md asserted
  // the opposite twice. A bot that can enter and cannot exit is the worst of
  // the available states.
  exitEnabled                 Boolean @default(true)
  takeProfitEnabled           Boolean @default(false)
  takeProfitPct               Float?
  // BOT-003: a position with no stop is unbounded. On by default, with a 3 %
  // distance, and the API refuses a large position size with it turned off.
  stopLossEnabled             Boolean @default(true)
  stopLossPct                 Float?  @default(3)
  maxEntryOrders              Int?
  maxActiveSmartTradesEnabled Boolean @default(false)
  maxActiveSmartTrades        Int?

  exchangeAccountId String?
  exchangeAccount   ExchangeAccount? @relation(fields: [exchangeAccountId], references: [id])
  smartTrades       SmartTrade[]
  webhookLogs       WebhookLog[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

// F5: botId is nullable + SetNull so deleting a bot preserves all historical trades.
// botName is denormalised so trade history still shows the original bot name after deletion.
model SmartTrade {
  id                String         @id @default(uuid())
  botId             String?
  bot               SignalBot?     @relation(fields: [botId], references: [id], onDelete: SetNull)
  botName           String         @default("")
  pair              String
  direction         String         @default("long")
  status            String         @default("active")
  entryPrice        Float?
  currentPrice      Float?
  quantity          Float          @default(0)
  quoteSpent        Float          @default(0)
  pnlUsdt           Float          @default(0)
  pnlPct            Float          @default(0)
  buyPrice          Float?
  /**
   * BOT-025: this was nullable and non-unique, so the same exchange order could
   * be recorded against two trades and there was no way to look a trade up by
   * the order that created it.
   * It gains an INDEX rather than a UNIQUE constraint, deliberately. A unique
   * index would fail to build if a live database already contains a duplicate,
   * and a migration that refuses to apply blocks startup — a worse outcome than
   * the defect. The uniqueness guarantee lives on `clientOrderId` below, which
   * is new and therefore cannot conflict with existing rows.
   */
  exchangeOrderId   String?
  /**
   * Deterministic client order id, so an order that succeeded at Binance but
   * threw locally afterwards can be found again (BOT-007).
   */
  clientOrderId     String?        @unique
  /**
   * Client order id of the resting exchange-side protective order, when one
   * was placed. Disabled by default — see services/exchangeStops.ts.
   */
  protectiveOrderId String?
  closedReason      String?
  createdAt         DateTime       @default(now())
  closedAt          DateTime?
  updatedAt         DateTime       @updatedAt
  partialCloses     PartialClose[]

  /** Manual Spot positions reuse the canonical trade ledger. */
  source             String           @default("strategy")
  exchangeAccountId  String?
  exchangeAccount    ExchangeAccount? @relation(fields: [exchangeAccountId], references: [id])
  manualOrderId      String?          @unique
  manualOrder        ManualOrder?     @relation("ManualEntryTrade", fields: [manualOrderId], references: [id], onDelete: SetNull)
  manualTpPrice      Float?
  manualSlPrice      Float?
  protectionType     String?
  protectionState    String?

  // BOT-024: every hot query filters on status, and most also on bot or pair.
  // Without these, the 30-second TP/SL loop and the 60-second manual-close sync
  // both table-scan on every tick.
  @@index([status])
  @@index([botId, status])
  @@index([pair, status])
  @@index([closedAt])
  @@index([exchangeOrderId])
  @@index([exchangeAccountId, status])
}

/**
 * Durable lifecycle for manual Spot orders. This is an order ledger, not a
 * second position/trade ledger: filled BUY entries point at SmartTrade.
 */
model ManualOrder {
  id                   String           @id @default(uuid())
  requestId            String           @unique
  exchangeAccountId    String
  exchangeAccount      ExchangeAccount  @relation(fields: [exchangeAccountId], references: [id])
  entryTrade            SmartTrade?      @relation("ManualEntryTrade")
  linkedPositionId      String?
  symbol                String
  side                  String
  orderType             String
  quantityType          String
  requestedBaseQty      Float?
  requestedQuoteQty     Float?
  limitPrice            Float?
  takeProfitPrice       Float?
  stopLossPrice         Float?
  protectionType        String?
  protectionState       String?
  /// The exact authenticated Shariah decision this order was admitted under,
  /// or null for an order placed with no decision attached. Recovery re-reads
  /// this rather than taking a fresh decision.
  shariahContext        String?
  status                String           @default("requested")
  exchangeOrderId       String?
  clientOrderId         String            @unique
  filledBaseQty         Float             @default(0)
  filledQuoteQty        Float             @default(0)
  averageFillPrice      Float?
  error                 String?
  submittedAt           DateTime?
  completedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([exchangeAccountId, symbol, createdAt])
}

/** Every platform command has one durable, replayable result. */
model ManualCommand {
  id        String   @id @default(uuid())
  requestId String   @unique
  kind      String
  status    String   @default("processing")
  result    String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** HMAC nonces are persisted so replay protection survives restarts/workers. */
model ManualNonce {
  nonce     String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// F4: Each row records one partial sell on an active trade.
model PartialClose {
  id              String     @id @default(uuid())
  tradeId         String
  trade           SmartTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  pct             Float
  quantity        Float
  revenue         Float
  pnlUsdt         Float
  avgPrice        Float
  exchangeOrderId String?
  /** Exactly-once key for a recovered strategy SELL partial. Existing rows stay null. */
  strategyIntentId String?    @unique
  createdAt       DateTime   @default(now())

  // BOT-024: this index existed and was DROPPED by
  // 20260712224627_web_push_security/migration.sql, never recreated. Every
  // final close reads a trade's partial closes to accumulate their P&L.
  @@index([tradeId])
}

/**
 * Durable monetary truth for webhook-driven strategy MARKET orders.
 *
 * A row is created as `requested` before the process may cross the exchange
 * boundary. It is changed to `submitted` durably before the wire call, so any
 * later process must query `clientOrderId` rather than place another order.
 * SmartTrade remains the position/accounting ledger; this row only carries the
 * minimum submission and reconstruction state across a crash.
 */
model StrategyOrderIntent {
  id                String   @id @default(uuid())
  sourceKey         String   @unique
  webhookLogId      String?
  botId             String
  botName           String
  exchangeAccountId String?
  clientOrderId     String   @unique
  symbol            String
  side              String
  orderType         String   @default("MARKET")
  requestedBaseQty  Float?
  requestedQuoteQty Float?
  sellPercent       Float?
  exitLeg           String?
  /** Exact Platform provenance supplied by the custom delivery contract. */
  platformDeploymentId String?
  platformOrderIntentId String?
  platformDedupeKey     String?
  platformWebhookIdentity String?
  /// The exact authenticated Shariah decision this intent was admitted under,
  /// or null when none was attached. For a SELL this is evidence only: an exit
  /// is never gated on it.
  shariahContext    String?
  /// The single-use Platform authorisation this entry was admitted under, stored
  /// as a hash so a live authorisation identifier is never at rest here. UNIQUE
  /// is the whole replay defence: one signed Shariah decision can claim at most
  /// one intent, whatever `dedupe_key`, request id or client order id
  /// accompanies it. Null for every path that carries no detached evidence —
  /// SELLs, the manual HMAC channel, and everything admitted while Shariah
  /// enforcement is off — and SQLite, like Postgres, treats those nulls as
  /// distinct, so they never collide with each other.
  authorizationNonceHash String? @unique
  skipExitCheck     Boolean  @default(false)
  smartTradeId      String?
  status            String   @default("requested")
  exchangeOrderId   String?
  exchangeStatus    String?
  filledBaseQty     Float    @default(0)
  filledQuoteQty    Float    @default(0)
  averageFillPrice  Float?
  simulated         Boolean  @default(false)
  error             String?
  submittedAt       DateTime?
  reconciledAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, createdAt])
  @@index([smartTradeId, status])
  @@index([botId, symbol, status])
}

/// The last Shariah enforcement mode the Platform asserted for one sender
/// scope, so omitting the block cannot silently downgrade a scope that was
/// already told to enforce.
///
/// This is NOT a Shariah registry: it holds a mode and a policy identity, never
/// an asset, a status, or any screening input. The Platform remains the sole
/// authority for what any asset's status is.
model ShariahEnforcement {
  scope         String   @id
  mode          String
  policyVersion String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/**
 * Immutable publication outbox for real custom-strategy accounting results.
 * `payload` is the canonical v1 wire payload captured at the accounting
 * transaction; delivery never rebuilds it from mutable SmartTrade state.
 */
model RealizationEvent {
  id               String   @id
  strategyIntentId String   @unique
  kind             String
  eventTime        DateTime
  payload          String
  payloadSha256    String
  deliveryStatus   String   @default("pending")
  attempts         Int      @default(0)
  nextAttemptAt    DateTime @default(now())
  deliveredAt      DateTime?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([deliveryStatus, nextAttemptAt, createdAt])
}

model WebhookLog {
  id        String     @id @default(uuid())
  botId     String?
  bot       SignalBot? @relation(fields: [botId], references: [id], onDelete: SetNull)
  payload   String
  status    String
  message   String?
  createdAt DateTime   @default(now())
}

// ─── Auth ──────────────────────────────────────────────────────────────────

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  passwordHash      String
  totpSecret        String?
  totpEnabled       Boolean            @default(false)
  createdAt         DateTime           @default(now())
  refreshTokens     RefreshToken[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Persists webhook idempotency across restarts and multiple server workers.
model WebhookReceipt {
  id        String   @id @default(uuid())
  keyHash   String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/**
 * BOT-019: the stale-sell guard was an in-memory Map that evaporated on
 * restart, while the idempotency guard beside it (`WebhookReceipt`) was
 * deliberately durable. After a restart the guard was blind, so a delayed SELL
 * meant for a closed trade could close the trade that replaced it.
 * One row per (bot, pair), updated on every close.
 */
model PairCloseMark {
  id        String   @id @default(uuid())
  botId     String
  pair      String
  closedAt  DateTime
  createdAt DateTime @default(now())

  @@unique([botId, pair])
  @@index([closedAt])
}

/**
 * BOT-011: account-level risk controls. A single row, `id = "global"`.
 * Every limit is null (disabled) and `tradingHalted` false on creation, so
 * adding this table changes no behaviour until an operator sets a number.
 */
model RiskControl {
  id                    String    @id @default("global")
  tradingHalted         Boolean   @default(false)
  haltedReason          String?
  haltedBy              String?
  haltedAt              DateTime?
  maxTotalExposureQuote Float?
  maxConcurrentTrades   Int?
  maxDailyLossQuote     Float?
  dailyLossWindowHours  Int       @default(24)
  updatedAt             DateTime  @updatedAt
}

/**
 * Durable per-attempt identity for the exchange orders that are placed OUTSIDE
 * `StrategyOrderIntent` — the dashboard partial close, the TP/SL monitor and
 * the manual protection poller.
 *
 * BOT-P1-1: those three sites derived their client order id from a scope that
 * named only the position and a non-unique discriminator (`partial:<id>:<pct>`,
 * `tpsl:<id>:tp`). Two genuinely distinct orders therefore reused one exchange
 * client order id, and `marketSellBase`'s duplicate-rejection branch — which is
 * correct for a true retry — resolved the SECOND order to the FIRST one's fill.
 *
 * The row is the missing authority. `intentKey` names the logical order slot;
 * `attempt` is a durable counter within it, never a clock. Exactly one attempt
 * per slot is `open` at a time: a retry or a crash recovery of the same logical
 * order finds that row and reuses its id, and a genuinely new order can only be
 * opened once the previous attempt has been SETTLED — which happens in the same
 * transaction that applies its fill locally. That makes the settle transition
 * the exactly-once key as well: a recovered fill can be applied by whoever wins
 * it, and by nobody twice.
 */
model ExchangeOrderAttempt {
  id              String    @id @default(uuid())
  /// Stable identity of the logical order slot this attempt belongs to.
  intentKey       String
  /// Monotonic attempt number within `intentKey`. A counter, never a timestamp.
  attempt         Int
  /// The exchange-facing client order id derived from (intentKey, attempt).
  clientOrderId   String    @unique
  symbol          String
  side            String
  /// `open` while this attempt owns the slot; `settled` once its result was
  /// applied; `abandoned` once the exchange proved it moved nothing.
  status          String    @default("open")
  exchangeOrderId String?
  settledAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /**
   * BOT-P1-5: the owning position.
   *
   * The attempt row already carried the durable identity of a non-intent exit;
   * what it did not carry was any way to ASK "does this position have an exit
   * that may have reached the exchange?". `intentKey` embeds the trade id in a
   * string, which is not a query, so close admission — which reasons about
   * `StrategyOrderIntent` — could not see a TP, SL or partial-close attempt at
   * all. After a restart the in-process close lock is gone and the attempt is
   * the only surviving evidence, so this column is what lets the same
   * query-first recovery cover it.
   */
  smartTradeId    String?
  /// Which exit authority owns this attempt: `tpsl`, `partial`, `manual-protection`.
  origin          String?
  /// Requested base quantity. INTENT ONLY — never accounting (BOT-P1-6).
  requestedBaseQty Float?
  /// Partial-close percentage, for the `PartialClose` row a recovery must write.
  sellPercent     Float?
  /// `closedReason` to stamp on the trade when this exit covers the position.
  closedReason    String?
  /**
   * Set immediately BEFORE the exchange call, so a null value durably proves
   * the order never crossed the submission boundary — the same distinction
   * `StrategyOrderIntent` draws between `requested` and `submitted`, and what
   * lets `-2013` be read as real absence without the settle window.
   */
  submittedAt     DateTime?
  /// Last exchange status observed for this attempt. Evidence, never a decision.
  exchangeStatus  String?

  @@unique([intentKey, attempt])
  @@index([intentKey, status])
  @@index([smartTradeId, status])
}
