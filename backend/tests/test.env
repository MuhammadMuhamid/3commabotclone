# Deterministic environment for the local test suite.
# Non-secret fixtures only: never point these at a real database, exchange
# account or production key. DRY_RUN stays true so no code path can trade.
NODE_ENV=test
DRY_RUN=true
DATABASE_URL=file:./tests/.tmp-test.db
ENCRYPTION_KEY=test-only-encryption-key-000000000000
SCRYPT_SALT=00112233445566778899aabbccddeeff
JWT_SECRET=test-only-jwt-secret-00000000000000000000000000
SECURE_COOKIES=false
CORS_ORIGIN=http://localhost:5173
VAPID_SUBJECT=mailto:test@example.test
