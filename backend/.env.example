# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
PUBLIC_URL=https://bot.alphawebstudioz.com
DRY_RUN=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=file:/app/data/bot.db

# ── Encryption (AES-256-GCM for Binance API keys at rest) ────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-a-long-random-string-at-least-32-chars

# scrypt KDF salt. Generate: openssl rand -hex 16
# WARNING: changing this after first deploy requires re-entering all API keys.
SCRYPT_SALT=change-me-to-16-hex-chars

# ── Authentication (JWT) ──────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=change-me-to-a-very-long-random-string-for-jwt-signing

# Set to false only in local development (HTTP). Always true in production.
SECURE_COOKIES=true

# ── CORS ─────────────────────────────────────────────────────────────────────
# Must match the exact origin of the frontend. Defaults to Vite dev server.
CORS_ORIGIN=https://bot.alphawebstudioz.com

# ── Binance (optional legacy env-var fallback — prefer Settings page) ────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ── Mobile Web Push ──────────────────────────────────────────────────────────
# Generate together: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@alphawebstudioz.com
