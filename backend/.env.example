# ─────────────────────────────────────────────────────────────────────────────
# Execution-bot backend configuration.
#
# Copy to `.env` and fill in. NO REAL VALUE BELONGS IN THIS FILE — it is
# tracked in git, and `scripts/ci/scan-secrets.sh` fails the build on a
# credential-shaped literal in tracked source.
#
# Every check in `assertConfig()` runs UNCONDITIONALLY and exits non-zero on
# failure, in dry run as much as in live mode. The previous behaviour — warn in
# dry run, fail only in live — meant `cp .env.example .env` produced a running
# server whose API-key encryption key and JWT signing secret were constants
# published in this repository.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
PUBLIC_URL=http://localhost:4000

# THE ONLY SAFE DEFAULT.
#
# `false` means every accepted webhook places a real Binance Spot market order
# with real money. Leave this `true` until you have deliberately decided
# otherwise, and understand that dry run simulates the exchange only — it still
# reads your real balances.
DRY_RUN=true

# Set to `production` in a deployed container: it stops Express returning stack
# traces on an unhandled error.
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# This file holds the ENCRYPTED Binance API keys and the whole trade history.
# `docker compose down -v` destroys it. Back it up: see scripts/backup-db.sh.
DATABASE_URL=file:./data/bot.db

# ── Encryption (AES-256-GCM for Binance API keys at rest) ────────────────────
# Required, at least 32 characters, and rejected if it is a value published in
# this repository. There is no insecure fallback: with this unset the server
# will not start, and an exchange account cannot be saved.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# scrypt KDF salt. Must be EXACTLY 32 hexadecimal characters — Node's
# `Buffer.from(str, "hex")` stops at the first non-hex character without
# throwing, so a passphrase-style salt used to pass the old length check and
# leave scrypt running unsalted. This is now validated with a regex.
#
# WARNING: changing it after first use makes every stored API key
# undecryptable; they must be re-entered in Settings.
# Generate: openssl rand -hex 16
SCRYPT_SALT=

# ── Authentication ────────────────────────────────────────────────────────────
# Signs session tokens. Required, at least 32 characters, not a published value.
# Changing it signs everyone out.
# Generate: openssl rand -hex 64
JWT_SECRET=

# Required to create the FIRST account, and only the first. Registration used to
# be open to the internet until an account existed, on a host whose name is
# published by certificate transparency the moment certbot runs. Set this to a
# value you transmit out of band, use it once, then remove it.
# Generate: openssl rand -hex 32
SETUP_TOKEN=

# Set to false only in local development over plain HTTP. Always true with TLS.
SECURE_COOKIES=true

# ── CORS ─────────────────────────────────────────────────────────────────────
# The exact origin of the frontend, or the browser drops the session cookies.
CORS_ORIGIN=http://localhost:5173

# ── Binance (optional legacy env-var fallback — prefer the Settings page) ────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ── Manual Spot trading from the platform (opt-in) ───────────────────────────
# Both gates default false. Mainnet additionally requires a per-order explicit
# confirmation, enforced by this bot rather than trusted to browser state.
MANUAL_TRADING_ENABLED=false
MAINNET_MANUAL_TRADING_ENABLED=false
# Shared only with the platform backend; never expose it to browser code.
# Generate: openssl rand -hex 32
MANUAL_TRADING_HMAC_SECRET=

# ── Mobile Web Push ──────────────────────────────────────────────────────────
# Generate together: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
