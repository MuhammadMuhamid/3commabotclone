# ─────────────────────────────────────────────────────────────────────────────
# Execution-bot backend configuration.
#
# Copy to `.env` and fill in. NO REAL VALUE BELONGS IN THIS FILE — it is
# tracked in git, and `scripts/ci/scan-secrets.sh` fails the build on a
# credential-shaped literal in tracked source.
#
# Every check in `assertConfig()` runs UNCONDITIONALLY and exits non-zero on
# failure, in dry run as much as in live mode. The previous behaviour — warn in
# dry run, fail only in live — meant `cp .env.example .env` produced a running
# server whose API-key encryption key and JWT signing secret were constants
# published in this repository.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# 4000 is correct as it stands, and the Docker path depends on it:
# `docker-compose.yml` maps `127.0.0.1:4000:4000`, the image EXPOSEs 4000 and
# its healthcheck probes 4000. Do not change it for a container deployment.
#
# One collision to know about: the Platform backend ALSO defaults to 4000. If
# you run both on the same Mac outside Docker, move THE BOT, not the Platform —
# the Platform's `MANUAL_TRADING_BOT_URL`, which carries the real-money manual
# order path and the Shariah installation-floor push, already defaults to
# `http://localhost:4001`. So:
#
#   PORT=4001
#   PUBLIC_URL=http://localhost:4001
#   and point the frontend dev proxy at 4001, in `frontend/vite.config.ts`.
PORT=4000
PUBLIC_URL=http://localhost:4000

# THE ONLY SAFE DEFAULT.
#
# `false` means every accepted webhook places a real Binance Spot market order
# with real money. Leave this `true` until you have deliberately decided
# otherwise, and understand that dry run simulates the exchange only — it still
# reads your real balances.
DRY_RUN=true

# Set to `production` in a deployed container: it stops Express returning stack
# traces on an unhandled error.
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# This file holds the ENCRYPTED Binance API keys and the whole trade history.
# `docker compose down -v` destroys it. Back it up: see scripts/backup-db.sh.
DATABASE_URL=file:./data/bot.db

# ── Encryption (AES-256-GCM for Binance API keys at rest) ────────────────────
# Required, at least 32 characters, and rejected if it is a value published in
# this repository. There is no insecure fallback: with this unset the server
# will not start, and an exchange account cannot be saved.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# scrypt KDF salt. Must be EXACTLY 32 hexadecimal characters — Node's
# `Buffer.from(str, "hex")` stops at the first non-hex character without
# throwing, so a passphrase-style salt used to pass the old length check and
# leave scrypt running unsalted. This is now validated with a regex.
#
# WARNING: changing it after first use makes every stored API key
# undecryptable; they must be re-entered in Settings.
# Generate: openssl rand -hex 16
SCRYPT_SALT=

# ── Authentication ────────────────────────────────────────────────────────────
# Signs session tokens. Required, at least 32 characters, not a published value.
# Changing it signs everyone out.
# Generate: openssl rand -hex 64
JWT_SECRET=

# Required to create the FIRST account, and only the first. Registration used to
# be open to the internet until an account existed, on a host whose name is
# published by certificate transparency the moment certbot runs. Set this to a
# value you transmit out of band, use it once, then remove it.
# Generate: openssl rand -hex 32
SETUP_TOKEN=

# Set to false only in local development over plain HTTP. Always true with TLS.
SECURE_COOKIES=true

# ── CORS ─────────────────────────────────────────────────────────────────────
# The exact origin of the frontend, or the browser drops the session cookies.
CORS_ORIGIN=http://localhost:5173

# ── Binance (optional legacy env-var fallback — prefer the Settings page) ────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# Exchange-native protective orders (resting STOP_LOSS_LIMIT at Binance).
# OFF is the fail-safe default: with this unset or off, a stop loss is a
# 30-second in-process poll and nothing rests at the exchange. Do not turn it on
# until the five testnet checks documented at the top of
# `backend/src/services/exchangeStops.ts` have actually been completed.
EXCHANGE_STOPS_ENABLED=false

# ── Manual Spot trading from the platform (opt-in) ───────────────────────────
# Both gates default false. Mainnet additionally requires a per-order explicit
# confirmation, enforced by this bot rather than trusted to browser state.
MANUAL_TRADING_ENABLED=false
MAINNET_MANUAL_TRADING_ENABLED=false
# Shared only with the platform backend; never expose it to browser code.
# Generate: openssl rand -hex 32
#
# This is the Platform -> Bot CONTROL-PLANE key, not just a manual-order key.
# It also authenticates the Shariah installation-floor control
# (PUT /api/manual-trading/shariah-enforcement) and the detached Shariah
# evidence on the direct webhook path — both of which the Platform uses whether
# or not MANUAL_TRADING_ENABLED is true. Set it on ANY installation that will
# turn Shariah Mode on, even one that never submits a manual order: without it
# the floor cannot be armed, and the bot answers 503 rather than pretending.
MANUAL_TRADING_HMAC_SECRET=

# X3A multi-venue Spot execution. This enables PAPER/TESTNET/DEMO only.
# There is intentionally no production/mainnet activation setting.
SPOT_EXECUTION_ENABLED=false

# X3B crypto perpetual/futures execution. This enables deterministic paper and
# modeled testnet/demo routes only; every external transport remains disabled
# until its non-production handshake is separately verified.
DERIVATIVE_EXECUTION_ENABLED=false

# X4 U.S. stock/ETF execution. Only Alpaca's paper-api host is compiled into
# this path; there is no production brokerage activation setting. Keep false
# until a separate PAPER key pair has been provisioned and the handshake has
# been verified. Never paste live-account keys here.
EQUITY_PAPER_EXECUTION_ENABLED=false
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=

# ── Authoritative realization delivery to Platform (opt-in) ─────────────────
REALIZATION_DELIVERY_ENABLED=false
REALIZATION_PLATFORM_URL=https://platform.example.com/api/internal/realization-events/v1
# Dedicated server-to-server HMAC key. Never expose it to either frontend.
# Generate: openssl rand -hex 32
REALIZATION_HMAC_SECRET=

# ── Mobile Web Push ──────────────────────────────────────────────────────────
# Generate together: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
