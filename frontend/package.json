    "react-router-dom": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.14",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.2.1"
  }
