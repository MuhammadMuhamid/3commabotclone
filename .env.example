# Copy to backend/.env and root for docker-compose

PUBLIC_URL=https://bot.yourdomain.com
DRY_RUN=true
PORT=4000
DATABASE_URL=file:./data/bot.db
ENCRYPTION_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Optional global Binance fallback (prefer UI Settings → Exchange account)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false
