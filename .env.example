# Root compose environment. Copy to `.env` and fill in.
#
# NO REAL VALUE BELONGS IN THIS FILE — it is tracked in git. The backend
# service reads these; see `backend/.env.example` for what each one is and how
# to generate it. Every value below is required and validated at startup.

PUBLIC_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# 4000 is correct as it stands, and the Docker path depends on it:
# `docker-compose.yml` maps `127.0.0.1:4000:4000`, the image EXPOSEs 4000 and
# its healthcheck probes 4000. Do not change it for a container deployment.
#
# One collision to know about: the Platform backend ALSO defaults to 4000. If
# you run both on the same Mac outside Docker, move THE BOT, not the Platform —
# the Platform's `MANUAL_TRADING_BOT_URL`, which carries the real-money manual
# order path and the Shariah installation-floor push, already defaults to
# `http://localhost:4001`. So:
#
#   PORT=4001
#   PUBLIC_URL=http://localhost:4001
#   and point the frontend dev proxy at 4001, in `frontend/vite.config.ts`.
PORT=4000
NODE_ENV=production

# The only safe default. `false` places real Binance Spot orders.
DRY_RUN=true

DATABASE_URL=file:./data/bot.db

# openssl rand -hex 32
ENCRYPTION_KEY=
# openssl rand -hex 16 — EXACTLY 32 hex characters
SCRYPT_SALT=
# openssl rand -hex 64
JWT_SECRET=
# openssl rand -hex 32 — needed once, to create the first account
SETUP_TOKEN=

SECURE_COOKIES=true

# Optional global Binance fallback (prefer Settings → Exchange account)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# Exchange-native protective orders (resting STOP_LOSS_LIMIT at Binance).
#
# NOT WIRED. `placeProtection` and `cancelProtection` exist in
# `backend/src/services/exchangeStops.ts` and NOTHING CALLS EITHER, so turning
# this on changes a status string and places no order. Protection is a
# 30-second in-process poll in both states: a position is unprotected while
# this process is down, and a gap through the stop fills at the next tick.
#
# Leave it off. Before it can mean anything, the functions need call sites at
# entry and exit, and the five testnet checks documented at the top of that
# module need to have actually been completed.
EXCHANGE_STOPS_ENABLED=false

# Multi-venue Spot execution is restricted in code to paper/testnet/demo.
SPOT_EXECUTION_ENABLED=false

# Crypto derivatives remains paper/testnet/demo-only; no mainnet mode exists.
DERIVATIVE_EXECUTION_ENABLED=false

# OANDA practice / IBKR paper only; production execution is not representable.
TRADITIONAL_PAPER_EXECUTION_ENABLED=false
OANDA_PRACTICE_ACCOUNT_ID=
OANDA_PRACTICE_TOKEN=
IBKR_PAPER_GATEWAY_ENABLED=false

# Durable authoritative realization delivery (server-to-server only).
REALIZATION_DELIVERY_ENABLED=false
REALIZATION_PLATFORM_URL=https://platform.example.com/api/internal/realization-events/v1
REALIZATION_HMAC_SECRET=

# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
